<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Broadcasts - Hackathon Team Hub</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #1a1a2e; color: #fff; margin: 0; padding: 2rem; }
        .container { max-width: 800px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; }
        h1 { color: #e94560; margin: 0; }
        nav a { color: #fff; text-decoration: none; margin-left: 1.5rem; font-weight: bold; transition: color 0.3s; }
        nav a:hover { color: #ff6b81; }
        
        .error { color: #ff6b6b; margin-bottom: 1rem; background: rgba(255, 107, 107, 0.1); padding: 0.5rem; border-radius: 4px; }
        .success { color: #4cd137; margin-bottom: 1rem; background: rgba(76, 209, 55, 0.1); padding: 0.5rem; border-radius: 4px; }

        .form-container { background: #16213e; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
        .form-container h2 { margin-top: 0; color: #e94560; font-size: 1.25rem; }
        textarea { width: 100%; padding: 0.75rem; border: 1px solid #0f3460; border-radius: 6px; box-sizing: border-box; background: #0f3460; color: #fff; outline: none; font-size: 1rem; resize: vertical; min-height: 80px; margin-bottom: 1rem; transition: border-color 0.3s; }
        textarea:focus { border-color: #e94560; }
        button { padding: 0.75rem 1.5rem; background: #e94560; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; transition: background 0.3s; }
        button:hover { background: #d03050; }

        .broadcast { background: #16213e; padding: 1.5rem; border-radius: 8px; margin-bottom: 1rem; box-shadow: 0 2px 5px rgba(0,0,0,0.2); border-left: 4px solid #e94560; }
        .broadcast-header { display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 0.9rem; color: #a9a9a9; }
        .broadcast-author { font-weight: bold; color: #eccc68; }
        .broadcast-content { line-height: 1.5; white-space: pre-wrap; font-size: 1.05rem; }
        .no-broadcasts { text-align: center; color: #a9a9a9; margin-top: 2rem; font-style: italic; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Broadcasts</h1>
            <nav>
                <a href="/dashboard">Dashboard</a>
                <% if (currentRole === 'admin') { %>
                    <a href="/admin">Admin Panel</a>
                <% } %>
                <a href="/chat">Chat</a>
                <a href="/logout">Logout</a>
            </nav>
        </header>

        <% if (error) { %> <div class="error"><%= error %></div> <% } %>
        <% if (success) { %> <div class="success"><%= success %></div> <% } %>

        <% if (currentRole === 'admin') { %>
            <div class="form-container">
                <h2>Post a New Broadcast</h2>
                <form action="/broadcasts" method="POST">
                    <textarea name="content" placeholder="Type your broadcast message here..." required></textarea>
                    <button type="submit">Post Broadcast</button>
                </form>
            </div>
        <% } %>

        <div class="broadcasts-list">
            <% if (broadcasts.length === 0) { %>
                <div class="no-broadcasts">No broadcasts have been posted yet.</div>
            <% } else { %>
                <% broadcasts.forEach(broadcast => { %>
                    <div class="broadcast">
                        <div class="broadcast-header">
                            <div>Posted by <span class="broadcast-author"><%= broadcast.username %></span> (Admin)</div>
                            <div><%= new Date(broadcast.timestamp).toLocaleString() %></div>
                        </div>
                        <div class="broadcast-content"><%= broadcast.content %></div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</body>
</html>
